parameters:
	ignoreErrors:
		-
			message: '#^Using nullsafe property access "\?\-\>color" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Filament/Resources/BoxResource.php

		-
			message: '#^Using nullsafe property access "\?\-\>color" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Filament/Resources/DocumentFileResource.php

		-
			message: '#^Using nullsafe property access "\?\-\>company_code" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Services/BarcodeService.php

		-
			message: '#^Match arm comparison between ''correction'' and ''correction'' is always true\.$#'
			identifier: match.alwaysTrue
			count: 1
			path: app/Services/MovementTimelineService.php

		-
			# Intentional defensive default (see the comment above the match
			# in loginDenialReason()) — kept so an unrecognised status value
			# fails closed with a generic message instead of throwing
			# UnhandledMatchError, since this same match backs
			# canAccessPanel() on every authenticated request, not just login.
			message: '#^Match arm comparison between ''archived'' and ''archived'' is always true\.$#'
			identifier: match.alwaysTrue
			count: 1
			path: app/Services/AccessControlService.php

		-
			message: '#^Method App\\Services\\MovementTimelineService\:\:build\(\) should return Illuminate\\Support\\Collection\<int\|string, Illuminate\\Support\\Collection\<int, array\{time\: Carbon\\Carbon\|null, title\: string, detail\: string, actor\: mixed\}\>\> but returns Illuminate\\Support\\Collection\<\(int\|string\), Illuminate\\Support\\Collection\<int, array\{time\: Carbon\\Carbon\|null, title\: string, detail\: string, actor\: mixed\}\>\>\.$#'
			identifier: return.type
			count: 1
			path: app/Services/MovementTimelineService.php

		-
			message: '#^Using nullsafe property access "\?\-\>ancestry_path" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 3
			path: app/Services/MovementTimelineService.php

		-
			message: '#^Using nullsafe property access "\?\-\>name" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Services/MovementTimelineService.php

		-
			message: '#^Ternary operator condition is always true\.$#'
			identifier: ternary.alwaysTrue
			count: 2
			path: app/Services/ReportExportService.php

		-
			message: '#^Using nullsafe property access "\?\-\>customer_id" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Services/ScannerService.php
